    },
    "maskImageLocation": {
      "@id": "provision:maskImageLocation",
      "@type": "xsd:string"
    },
    "planningMode": {
      "@id": "provision:planningMode",
      "@type": "xsd:string"
    },
    "plannerProvider": {
      "@id": "provision:plannerProvider",
      "@type": "xsd:string"
    },
    "plannerModel": {
      "@id": "provision:plannerModel",
