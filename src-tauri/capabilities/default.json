{
  "identifier": "default",
  "description": "PROVision デスクトップアプリの既定権限",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/provision-server",
          "sidecar": true
        }
      ]
    },
    "shell:allow-kill",
    "updater:default",
    "process:allow-restart",
    "opener:default",
    "dialog:default",
    {
      "identifier": "http:default",
      "comment": "ポートは OS に選ばせる（D-024）ので番号で縛れない。8788 を残すのは、ワイルドカードが効かない環境でも従来どおり動くようにするため",
      "allow": [
        {
          "url": "http://127.0.0.1:*/*"
        },
        {
          "url": "http://localhost:*/*"
        },
        {
          "url": "http://127.0.0.1:8788/*"
        },
        {
          "url": "http://localhost:8788/*"
        }
      ]
    }
  ]
}
