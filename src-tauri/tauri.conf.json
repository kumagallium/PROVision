{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PROVision",
  "version": "0.1.0",
  "identifier": "io.github.kumagallium.provision",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev:web",
    "beforeBuildCommand": "node scripts/fetch-node.mjs && node scripts/bundle-server.mjs && pnpm build:web"
  },
  "app": {
    "windows": [
      {
        "title": "PROVision",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 640,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: http://127.0.0.1:8788; connect-src 'self' http://127.0.0.1:8788 ipc: http://ipc.localhost; worker-src 'self' blob:; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/provision-server"
    ],
    "resources": [
      "sidecar/server.mjs",
      "sidecar/node*"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://kumagallium.github.io/PROVision/updater/latest.json",
        "https://github.com/kumagallium/PROVision/releases/latest/download/latest.json"
      ],
      "pubkey": "PLACEHOLDER_REPLACE_WITH_MINISIGN_PUBLIC_KEY"
    }
  }
}
